# Existing UPC Connect deployment settings (use your own project values).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional server-only AI decision support. Never prefix these with NEXT_PUBLIC_.
# Leave the key empty to keep AI unavailable; ordinary Reports still works.
GEMINI_API_KEY=
# Omit or leave empty to use the central stable default documented in lib/ai/README.md.
GEMINI_MODEL=
